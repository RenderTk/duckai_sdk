# Optional: the defaults work without a .env file, browser window, or manual setup.
DUCKAI_AUTO_TOKEN=true
DUCKAI_BROWSER_HEADLESS=true
DUCKAI_BROWSER_AUTO_INSTALL=true
BROWSER_INSTALL_TIMEOUT=300
TOKEN_GENERATION_TIMEOUT=30
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=120

# Use your own Chromium executable or an existing debugging session.
# DUCKAI_BROWSER_EXECUTABLE=/absolute/path/to/chromium
# DUCKAI_BROWSER_CDP_URL=http://127.0.0.1:9222

MAX_COLLECTED_BYTES=8388608
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
